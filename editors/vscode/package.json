{
  "name": "ox-agent",
  "displayName": "ox",
  "description": "The ox coding agent in VS Code: its chat beside your code, and your selection sent to it.",
  "version": "0.1.0",
  "publisher": "ox-agent",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SAI141003/ox" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["AI", "Other"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "ox.openChat", "title": "ox: Open chat" },
      { "command": "ox.askSelection", "title": "ox: Ask about the selection" },
      { "command": "ox.fixProblem", "title": "ox: Fix the problems in this file" },
      { "command": "ox.runInTerminal", "title": "ox: Start in the terminal" }
    ],
    "menus": {
      "editor/context": [
        { "command": "ox.askSelection", "when": "editorHasSelection", "group": "ox" },
        { "command": "ox.fixProblem", "group": "ox" }
      ]
    },
    "keybindings": [{ "command": "ox.openChat", "key": "ctrl+alt+o", "mac": "cmd+alt+o" }],
    "configuration": {
      "title": "ox",
      "properties": {
        "ox.command": { "type": "string", "default": "ox", "description": "The command that starts ox." }
      }
    }
  }
}
