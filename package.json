{
  "name": "ox-agent",
  "version": "0.1.0",
  "description": "the featherweight coding agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ox": "./bin/ox.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "OX_ISLAND=0 OX_NO_BUILTIN_SKILLS=1 OX_NO_PLUGINS=1 node --test --test-concurrency=2 test/*.test.js",
    "start": "node bin/ox.js",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:loop": "node scripts/verify.mjs --loop"
  }
}
